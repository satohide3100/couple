LIFF_ID=2006147567-XL6E010Q
DATABASE_URL=postgresql://localhost/couples_bucket_list_development
REDIS_URL=redis://localhost:6379/1

# ===== freee会計 API（入金検知 / wallet_txns ポーリング）=====
# 動作確認用の静的アクセストークン（約6時間で失効・リフレッシュ不可）。
# 設定時はこれを優先使用。恒久運用には下のCLIENT_ID/SECRETでOAuthする。
FREEE_ACCESS_TOKEN=
# freeeアプリストア/開発者ページで発行した OAuth クライアント。
FREEE_CLIENT_ID=
FREEE_CLIENT_SECRET=
# 認可リダイレクトURI（freeeアプリ設定と一致させる）。
# 手動認可は OOB 既定（ブラウザに認可コードが表示される）
FREEE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
# 監視対象。freee:list_companies / freee:list_walletables で確認して設定
FREEE_COMPANY_ID=
FREEE_WALLETABLE_ID=
FREEE_WALLETABLE_TYPE=bank_account
# ポーリングで遡る日数（freeeの銀行自動同期の遅延に対するマージン）
FREEE_LOOKBACK_DAYS=3
# APIベース（通常変更不要）
FREEE_API_BASE_URL=https://api.freee.co.jp
FREEE_OAUTH_BASE_URL=https://accounts.secure.freee.co.jp

# ===== LINE Messaging API (プッシュ通知) =====
# LIFFとは別に Messaging APIチャネル を作成し、長期チャネルアクセストークンを発行する。
LINE_CHANNEL_ACCESS_TOKEN=
# （任意）受信Webhook署名検証用。本機能の送信では未使用
LINE_CHANNEL_SECRET=
# 配信方式: broadcast=公式アカウント友だち全員へ一斉 / push=特定userId
LINE_DELIVERY_MODE=broadcast
# push方式のときのみ必要（broadcastでは不要）。U から始まる33文字
LINE_NOTIFY_USER_ID=
